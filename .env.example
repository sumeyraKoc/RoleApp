# AI provider: set at least one of GEMINI_API_KEY or GROQ_API_KEY.
# Gemini is used when both are set (the current default behavior). When only
# GROQ_API_KEY is set, the AI service automatically switches to Groq, so you
# can change providers by editing a single line in .env if Gemini is unavailable.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional Gemini STT key; speech synthesis always uses GROQ_API_KEY.
GEMINI_STT_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Evaluation and correction run on the critical path of every turn. When empty,
# this uses GEMINI_MODEL for backward compatibility. You can set a faster,
# lighter Gemini model here independently.
GEMINI_EVALUATOR_MODEL=
CORRECTION_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-transcribe

GROQ_API_KEY=your-groq-api-key-here
# NPC dialogue on NVIDIA Nemotron via Nebius Token Factory (https://tokenfactory.nebius.com).
# When set, NPC replies use Nemotron and fall back to Gemini/Groq if it fails.
NEBIUS_API_KEY=
# Optional exact model id; when empty, the AI service picks a Nemotron model from your catalog.
NEBIUS_MODEL=
# Larger model for higher-quality NPC dialogue:
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_INVENTORY_MODEL=openai/gpt-oss-120b
# Groq's low-latency "instant" model for evaluation and correction. When empty,
# it defaults to llama-3.1-8b-instant, which is much faster than GROQ_MODEL (70b).
GROQ_EVALUATOR_MODEL=llama-3.1-8b-instant
GROQ_CORRECTION_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

LANGUAGE_ACCEPTANCE_THRESHOLD=50
STT_MAX_AUDIO_BYTES=10485760
USE_MOCK_AI=false

CORS_ORIGINS=

